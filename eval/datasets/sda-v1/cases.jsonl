{"id":"TC-URL-001","dataset_version":"sda-v1","split":"dev","stages":["requirements","hld","lld","dsa","learning"],"domain":"url-shortener","complexity":"low","idea":"Design a URL shortener with custom aliases and click counts.","confirmed_requirements":{"functional":[{"id":"fr_url_create","text":"Create a unique short code for a long URL, including optional custom aliases.","priority":"must"},{"id":"fr_url_redirect","text":"Redirect a short code to its original URL.","priority":"must"},{"id":"fr_url_count","text":"Record click counts per short code.","priority":"should"}],"nonFunctional":[{"id":"nfr_url_latency","text":"Redirects stay fast under normal load.","priority":"must","category":"performance","target":"p95 under 100 ms"},{"id":"nfr_url_availability","text":"Redirects remain available when analytics is degraded.","priority":"should","category":"reliability","target":"99.9% monthly availability"}],"assumptions":["Short codes are public.","Analytics can be eventually consistent."],"clarifications":["Custom aliases are globally unique."]},"must_have_behaviors":["unique code allocation","collision handling","fast redirect path","click counting","analytics decoupled from redirect latency"],"acceptable_alternatives":["PostgreSQL unique index","Redis cache","base62 encoding","Kafka or outbox for click events"],"anti_patterns":["no collision handling","synchronous analytics write on every redirect","predictable sequential public IDs"],"component_expectations":{"hld":["client","API gateway","URL service","relational store","cache","event broker","click worker","observability"],"lld":["URL service","URL repository","code generator","cache abstraction","click event publisher","URL mapping value object"],"dsa":["short-code generation","collision check","redirect lookup","click aggregation"],"learning":["unique code allocation","cache-aside redirect","asynchronous analytics"]},"review":{"status":"draft","reviewer":null,"reviewed_at":null},"tags":["cache","hashing","redirect","async","low"]}
{"id":"TC-RATE-002","dataset_version":"sda-v1","split":"dev","stages":["requirements","hld","lld","dsa","learning"],"domain":"rate-limiter","complexity":"medium","idea":"Design a distributed rate limiter for a public API with configurable per-client limits.","confirmed_requirements":{"functional":[{"id":"fr_rate_limit","text":"Enforce a configurable request limit per API key and time window.","priority":"must"},{"id":"fr_rate_headers","text":"Return 429 with Retry-After when the limit is exceeded.","priority":"must"},{"id":"fr_rate_policy","text":"Allow operators to update limits without redeploying the service.","priority":"should"}],"nonFunctional":[{"id":"nfr_rate_latency","text":"Rate-limit checks add minimal request latency.","priority":"must","category":"performance","target":"p95 under 10 ms"},{"id":"nfr_rate_consistency","text":"Limits remain consistent across service instances.","priority":"must","category":"reliability","target":"no more than 1% over-admission during normal operation"}],"assumptions":["API keys are unique per client.","Short bursts are allowed within the window."],"clarifications":["Fail-open is acceptable only for a configured emergency mode."]},"must_have_behaviors":["atomic counter update","distributed state","configurable window","Retry-After response","policy update path"],"acceptable_alternatives":["Redis Lua script","token bucket","sliding window","fixed window with atomic operations"],"anti_patterns":["in-memory counters as the only store","read-modify-write race","no clock-skew handling","unbounded key growth"],"component_expectations":{"hld":["client","API gateway","rate-limit service","distributed counter store","policy store","observability"],"lld":["rate limiter","policy repository","counter store abstraction","result value object"],"dsa":["token bucket","sliding window","atomic increment","TTL cleanup"],"learning":["atomicity","window algorithms","distributed consistency"]},"review":{"status":"draft","reviewer":null,"reviewed_at":null},"tags":["rate-limit","redis","distributed","atomicity","medium"]}
{"id":"TC-CHAT-003","dataset_version":"sda-v1","split":"dev","stages":["requirements","hld","lld","dsa","learning"],"domain":"chat","complexity":"medium","idea":"Design a chat system with one-to-one messages, group channels, history, presence, and read receipts.","confirmed_requirements":{"functional":[{"id":"fr_chat_send","text":"Send messages in one-to-one and group conversations.","priority":"must"},{"id":"fr_chat_history","text":"Load conversation history with pagination.","priority":"must"},{"id":"fr_chat_presence","text":"Show online presence and read receipts.","priority":"should"}],"nonFunctional":[{"id":"nfr_chat_latency","text":"Message delivery is responsive.","priority":"must","category":"performance","target":"p95 under 200 ms server acknowledgement"},{"id":"nfr_chat_order","text":"Messages preserve order within a conversation.","priority":"must","category":"reliability","target":"no reordering for accepted messages"}],"assumptions":["Users can be offline.","Read receipts are eventually consistent."],"clarifications":["Group size is bounded for the first release."]},"must_have_behaviors":["real-time delivery","durable message store","per-conversation ordering","offline delivery","presence fan-out","idempotent send"],"acceptable_alternatives":["WebSocket gateway","PostgreSQL message table","Redis pub/sub","Kafka event stream","push notification worker"],"anti_patterns":["polling as the only delivery path","global message ordering","no idempotency key","unbounded history query"],"component_expectations":{"hld":["client","WebSocket gateway","chat service","message store","presence service","pub/sub broker","push worker","observability"],"lld":["conversation service","message repository","presence tracker","delivery session","message value object"],"dsa":["ordered log","pagination cursor","presence set","deduplication key"],"learning":["WebSocket fan-out","ordering guarantees","offline delivery"]},"review":{"status":"draft","reviewer":null,"reviewed_at":null},"tags":["websocket","messaging","presence","ordering","medium"]}
{"id":"TC-NOTIFY-004","dataset_version":"sda-v1","split":"dev","stages":["requirements","hld","lld","dsa","learning"],"domain":"notifications","complexity":"medium","idea":"Design a notification service that sends email, SMS, and push notifications with templates and retries.","confirmed_requirements":{"functional":[{"id":"fr_notify_send","text":"Send notifications through email, SMS, and push channels.","priority":"must"},{"id":"fr_notify_prefs","text":"Respect user channel preferences and opt-outs.","priority":"must"},{"id":"fr_notify_status","text":"Expose delivery status and retry outcomes.","priority":"should"}],"nonFunctional":[{"id":"nfr_notify_delivery","text":"Notifications are delivered at least once.","priority":"must","category":"reliability","target":"99.9% accepted messages attempted"},{"id":"nfr_notify_dedupe","text":"Duplicate provider retries do not create duplicate user-visible sends.","priority":"must","category":"reliability","target":"zero duplicate sends for the same notification id"}],"assumptions":["Providers have independent rate limits.","Users may have multiple devices."],"clarifications":["Transactional notifications may bypass marketing opt-outs."]},"must_have_behaviors":["provider abstraction","template rendering","durable queue","retry with backoff","idempotency","dead-letter handling","preference enforcement"],"acceptable_alternatives":["SQS or Kafka queue","transactional outbox","provider adapter interface","Redis dedupe cache"],"anti_patterns":["calling providers synchronously in the request path","no retry policy","no idempotency","hardcoded templates"],"component_expectations":{"hld":["API service","queue","notification worker","provider adapters","preference store","dead-letter store","observability"],"lld":["notification service","template renderer","provider adapter","delivery repository","preference repository"],"dsa":["queue lease","retry backoff","dedupe set","dead-letter index"],"learning":["at-least-once delivery","idempotency","provider isolation"]},"review":{"status":"draft","reviewer":null,"reviewed_at":null},"tags":["queue","retry","email","sms","push","medium"]}
{"id":"TC-PAY-005","dataset_version":"sda-v1","split":"dev","stages":["requirements","hld","lld","dsa","learning"],"domain":"payments","complexity":"high","idea":"Design a payment ledger that supports charges, refunds, idempotency, and reconciliation.","confirmed_requirements":{"functional":[{"id":"fr_pay_charge","text":"Create a charge against an order with an idempotency key.","priority":"must"},{"id":"fr_pay_ledger","text":"Record every money movement as immutable double-entry ledger rows.","priority":"must"},{"id":"fr_pay_refund","text":"Support full and partial refunds linked to the original charge.","priority":"must"},{"id":"fr_pay_reconcile","text":"Reconcile provider settlement records against the ledger.","priority":"should"}],"nonFunctional":[{"id":"nfr_pay_atomicity","text":"Money movements are atomic and auditable.","priority":"must","category":"reliability","target":"no committed unbalanced ledger entry"},{"id":"nfr_pay_security","text":"Payment operations require authenticated, authorized requests.","priority":"must","category":"security","target":"all mutations authorized and audited"}],"assumptions":["Money is stored in minor units.","Provider webhooks may arrive out of order."],"clarifications":["Refunds cannot exceed the captured amount."]},"must_have_behaviors":["idempotent charge creation","double-entry ledger","transaction boundary","refund linkage","webhook verification","reconciliation job","audit trail"],"acceptable_alternatives":["PostgreSQL transactions","outbox for provider events","append-only ledger table","provider webhook idempotency"],"anti_patterns":["mutating a balance without ledger rows","floating-point money","no idempotency key","trusting unsigned webhooks"],"component_expectations":{"hld":["client","payment API","payment service","ledger database","provider adapter","webhook handler","reconciliation worker","observability"],"lld":["payment service","ledger repository","charge aggregate","refund aggregate","provider gateway","idempotency store"],"dsa":["idempotency key lookup","ledger append","reconciliation diff","settlement matching"],"learning":["double-entry accounting","idempotency","webhook ordering"]},"review":{"status":"draft","reviewer":null,"reviewed_at":null},"tags":["payments","ledger","acid","idempotency","high"]}
{"id":"TC-JOBS-006","dataset_version":"sda-v1","split":"dev","stages":["requirements","hld","lld","dsa","learning"],"domain":"job-queue","complexity":"medium","idea":"Design a durable background job queue with retries, priorities, dead letters, and job status.","confirmed_requirements":{"functional":[{"id":"fr_jobs_enqueue","text":"Enqueue jobs with a type, payload, and priority.","priority":"must"},{"id":"fr_jobs_retry","text":"Retry failed jobs with backoff and a maximum attempt count.","priority":"must"},{"id":"fr_jobs_status","text":"Expose job status and failure reason.","priority":"should"}],"nonFunctional":[{"id":"nfr_jobs_delivery","text":"Jobs are processed at least once.","priority":"must","category":"reliability","target":"no acknowledged job is lost on worker restart"},{"id":"nfr_jobs_latency","text":"Queued jobs start promptly under normal load.","priority":"should","category":"performance","target":"p95 start under 5 seconds"}],"assumptions":["Jobs are idempotent or carry a deduplication key.","Workers can crash at any time."],"clarifications":["Dead letters are retained for manual inspection."]},"must_have_behaviors":["durable enqueue","worker lease/ack","retry with backoff","dead-letter queue","priority handling","job status lookup","idempotent processing"],"acceptable_alternatives":["PostgreSQL SKIP LOCKED queue","Redis Streams","SQS","Kafka consumer group"],"anti_patterns":["in-memory queue as the only store","ack before work completes","infinite retries","no dead-letter path"],"component_expectations":{"hld":["producer API","queue store","worker pool","scheduler","dead-letter store","observability"],"lld":["job service","job repository","worker","retry policy","job state machine"],"dsa":["priority queue","lease timeout","retry backoff","dead-letter index"],"learning":["at-least-once processing","visibility timeout","backoff"]},"review":{"status":"draft","reviewer":null,"reviewed_at":null},"tags":["queue","worker","retry","dead-letter","medium"]}
{"id":"TC-FILES-007","dataset_version":"sda-v1","split":"dev","stages":["requirements","hld","lld","dsa","learning"],"domain":"file-storage","complexity":"high","idea":"Design a file storage service with large uploads, resumable transfers, metadata, and access control.","confirmed_requirements":{"functional":[{"id":"fr_files_upload","text":"Upload and download files, including large multipart files.","priority":"must"},{"id":"fr_files_meta","text":"Store file metadata and ownership.","priority":"must"},{"id":"fr_files_access","text":"Enforce per-file access control.","priority":"must"}],"nonFunctional":[{"id":"nfr_files_durability","text":"Stored files are durable.","priority":"must","category":"reliability","target":"99.999999999% object durability"},{"id":"nfr_files_range","text":"Support range downloads for large files.","priority":"should","category":"performance","target":"range requests served without full-file reads"}],"assumptions":["Object storage is available.","Files may be large."],"clarifications":["Sharing is limited to explicit users or links."]},"must_have_behaviors":["presigned upload/download","multipart upload","metadata store","ownership checks","checksum validation","range requests"],"acceptable_alternatives":["S3-compatible object store","PostgreSQL metadata table","CDN for downloads","virus scanning worker"],"anti_patterns":["storing blobs in the relational database","public buckets","no checksum","trusting client-supplied MIME type"],"component_expectations":{"hld":["client","file API","metadata service","object storage","access-control service","scanning worker","CDN","observability"],"lld":["file service","metadata repository","object-store adapter","access policy","upload session"],"dsa":["multipart chunk map","checksum verification","range index","access lookup"],"learning":["presigned URLs","multipart upload","object-store durability"]},"review":{"status":"draft","reviewer":null,"reviewed_at":null},"tags":["storage","multipart","security","durability","high"]}
{"id":"TC-SEARCH-008","dataset_version":"sda-v1","split":"dev","stages":["requirements","hld","lld","dsa","learning"],"domain":"search-autocomplete","complexity":"medium","idea":"Design a search autocomplete service that returns ranked prefix suggestions with low latency.","confirmed_requirements":{"functional":[{"id":"fr_search_suggest","text":"Return top-k prefix suggestions as the user types.","priority":"must"},{"id":"fr_search_rank","text":"Rank suggestions by popularity and freshness.","priority":"should"},{"id":"fr_search_update","text":"Update suggestion popularity without rebuilding the entire index.","priority":"should"}],"nonFunctional":[{"id":"nfr_search_latency","text":"Suggestions respond quickly.","priority":"must","category":"performance","target":"p95 under 50 ms"},{"id":"nfr_search_freshness","text":"Popularity updates become visible within a bounded delay.","priority":"should","category":"performance","target":"under 5 minutes"}],"assumptions":["Queries contain typos but prefix matching is the first release.","Top-k is small."],"clarifications":["Personalization is out of scope for v1."]},"must_have_behaviors":["prefix lookup","top-k ranking","low-latency cache","incremental popularity updates","query normalization"],"acceptable_alternatives":["Trie","Elasticsearch/OpenSearch","Redis sorted sets","CDN edge cache"],"anti_patterns":["full-table LIKE scan per keystroke","unbounded result sets","no debounce","rebuild index on every update"],"component_expectations":{"hld":["client","autocomplete API","prefix index","ranking service","popularity pipeline","cache","observability"],"lld":["suggestion service","prefix index","rank scorer","popularity repository","query normalizer"],"dsa":["trie","top-k heap","sorted set","LRU cache"],"learning":["prefix indexing","top-k selection","incremental ranking"]},"review":{"status":"draft","reviewer":null,"reviewed_at":null},"tags":["search","trie","ranking","latency","medium"]}
{"id":"TC-EDITOR-009","dataset_version":"sda-v1","split":"dev","stages":["requirements","hld","lld","dsa","learning"],"domain":"collaborative-editor","complexity":"high","idea":"Design a real-time collaborative document editor with presence, conflict resolution, history, and access control.","confirmed_requirements":{"functional":[{"id":"fr_edit_realtime","text":"Multiple users can edit the same document in real time.","priority":"must"},{"id":"fr_edit_history","text":"Persist document history and support restoration.","priority":"must"},{"id":"fr_edit_presence","text":"Show collaborator presence and cursors.","priority":"should"}],"nonFunctional":[{"id":"nfr_edit_consistency","text":"Concurrent edits converge to the same document state.","priority":"must","category":"reliability","target":"no permanent divergence after reconnect"},{"id":"nfr_edit_latency","text":"Remote edits appear quickly.","priority":"must","category":"performance","target":"p95 under 150 ms"}],"assumptions":["Documents are bounded in size.","Users may reconnect after being offline."],"clarifications":["Access is document-scoped."]},"must_have_behaviors":["real-time sync","conflict resolution","durable document store","presence fan-out","version history","authorization"],"acceptable_alternatives":["CRDT","operational transformation","WebSocket gateway","PostgreSQL snapshots","Redis presence"],"anti_patterns":["last-write-wins without conflict handling","polling as the only sync path","no durable snapshots","global document lock for all edits"],"component_expectations":{"hld":["client","WebSocket gateway","document service","conflict engine","snapshot store","presence service","authorization","observability"],"lld":["document session","operation log","CRDT/OT engine","snapshot repository","presence tracker"],"dsa":["operation log","CRDT merge","snapshot compaction","presence set"],"learning":["CRDT vs OT","offline reconciliation","snapshot compaction"]},"review":{"status":"draft","reviewer":null,"reviewed_at":null},"tags":["collaboration","crdt","websocket","consistency","high"]}
{"id":"TC-OBS-010","dataset_version":"sda-v1","split":"dev","stages":["requirements","hld","lld","dsa","learning"],"domain":"observability","complexity":"medium","idea":"Design an observability pipeline for logs, metrics, and traces with querying, alerting, sampling, and retention.","confirmed_requirements":{"functional":[{"id":"fr_obs_ingest","text":"Ingest logs, metrics, and traces from services.","priority":"must"},{"id":"fr_obs_query","text":"Query recent telemetry by service and time range.","priority":"must"},{"id":"fr_obs_alert","text":"Evaluate alert rules and notify on-call.","priority":"should"}],"nonFunctional":[{"id":"nfr_obs_ingest","text":"Ingest handles bursty traffic without losing acknowledged data.","priority":"must","category":"scalability","target":"10x normal ingest for 5 minutes"},{"id":"nfr_obs_query","text":"Recent queries return quickly.","priority":"should","category":"performance","target":"p95 under 2 seconds for 1-hour range"}],"assumptions":["Telemetry volume is much larger than query volume.","Not every trace is retained forever."],"clarifications":["Sampling policy is configurable."]},"must_have_behaviors":["collector layer","durable ingest buffer","time-series/log/trace storage","query API","alert evaluator","sampling","retention policy"],"acceptable_alternatives":["Kafka buffer","ClickHouse or OpenSearch","Prometheus for metrics","S3 for long-term retention"],"anti_patterns":["synchronous write to the primary database on request path","no sampling","unbounded retention","alerting from raw high-cardinality data"],"component_expectations":{"hld":["agents","collector","ingest queue","storage backends","query service","alert evaluator","notification worker","observability"],"lld":["collector service","ingest buffer","query service","alert rule engine","retention policy"],"dsa":["time-series index","inverted index","sampling decision","retention window"],"learning":["ingest buffering","sampling","retention trade-offs"]},"review":{"status":"draft","reviewer":null,"reviewed_at":null},"tags":["observability","ingest","sampling","retention","medium"]}
{"id":"TC-SOCIAL-011","dataset_version":"sda-v1","split":"dev","stages":["requirements","hld","lld","dsa","learning"],"domain":"social-media","complexity":"high","idea":"Design a social media feed with posts, follows, likes, comments, media, ranking, and notifications.","confirmed_requirements":{"functional":[{"id":"fr_social_post","text":"Users can publish text and media posts.","priority":"must"},{"id":"fr_social_follow","text":"Users can follow and unfollow other users.","priority":"must"},{"id":"fr_social_feed","text":"Show a ranked, paginated feed of posts from followed users.","priority":"must"},{"id":"fr_social_engage","text":"Support likes, comments, and notifications for engagement.","priority":"should"}],"nonFunctional":[{"id":"nfr_social_latency","text":"Feed requests stay responsive.","priority":"must","category":"performance","target":"p95 under 300 ms for cached first page"},{"id":"nfr_social_fanout","text":"Publishing a post reaches followers without blocking the request.","priority":"must","category":"scalability","target":"asynchronous fan-out with bounded delay"},{"id":"nfr_social_safety","text":"Media and posts enforce authorization and moderation hooks.","priority":"should","category":"security","target":"no unauthorized post or media access"}],"assumptions":["Most users follow many accounts.","Feed is eventually consistent.","Media lives in object storage."],"clarifications":["Chronological and ranked modes may share the same feed store."]},"must_have_behaviors":["post publishing","social graph","fan-out strategy","feed ranking","cursor pagination","media storage","engagement events","notification fan-out"],"acceptable_alternatives":["fan-out on write","fan-out on read","hybrid fan-out","Redis timeline cache","PostgreSQL social graph","object storage plus CDN"],"anti_patterns":["full-table scan on every feed request","synchronous fan-out to every follower","unbounded feed query","no authorization on media","no moderation hook"],"component_expectations":{"hld":["client","feed API","post service","social graph","fan-out worker","feed cache","media store","notification worker","observability"],"lld":["feed service","follow repository","post repository","fan-out worker","ranker","timeline entry"],"dsa":["timeline merge","graph traversal","top-k ranking","cursor pagination","set deduplication"],"learning":["fan-out trade-offs","feed ranking","cursor pagination"]},"review":{"status":"draft","reviewer":null,"reviewed_at":null},"tags":["social","feed","fanout","ranking","media","high"]}
{"id":"TC-AGENT-012","dataset_version":"sda-v1","split":"dev","stages":["requirements","hld","lld","dsa","learning"],"domain":"agent-library","complexity":"high","idea":"Design an agent library where teams publish, version, discover, and run AI agents with tools, permissions, sandboxing, and audit logs.","confirmed_requirements":{"functional":[{"id":"fr_agent_publish","text":"Publish an agent with a name, description, version, and declared tools.","priority":"must"},{"id":"fr_agent_discover","text":"Search and inspect agents by capability and version.","priority":"must"},{"id":"fr_agent_run","text":"Run a selected agent version with authorized tools in an isolated environment.","priority":"must"},{"id":"fr_agent_audit","text":"Record who ran which agent version, with what tools, and the outcome.","priority":"must"}],"nonFunctional":[{"id":"nfr_agent_sandbox","text":"Untrusted agent code cannot access the API process or other tenants.","priority":"must","category":"security","target":"isolated worker with least-privilege tool access"},{"id":"nfr_agent_latency","text":"Catalog search stays responsive.","priority":"should","category":"performance","target":"p95 under 200 ms"},{"id":"nfr_agent_secrets","text":"Tool credentials are never returned to the agent or client.","priority":"must","category":"security","target":"brokered, short-lived credentials"}],"assumptions":["Agents may be authored by different teams.","A version is immutable once published.","Execution may be long-running."],"clarifications":["Tool permissions are explicit capabilities, not implicit network access."]},"must_have_behaviors":["immutable versioning","capability search","tool permission model","sandboxed execution","short-lived secrets","audit trail","run status"],"acceptable_alternatives":["PostgreSQL metadata plus object storage","queue-backed sandbox workers","policy engine","OpenSearch for capability search"],"anti_patterns":["executing untrusted agent code in the API process","returning tool secrets to the agent","mutable published versions","no tenant isolation","no run audit"],"component_expectations":{"hld":["client","registry API","catalog search","version store","execution service","sandbox worker","tool broker","audit log","observability"],"lld":["agent registry","agent version","capability policy","execution service","sandbox adapter","secret broker","audit logger"],"dsa":["inverted capability index","version lookup","permission graph","run queue","audit append"],"learning":["sandbox isolation","capability-based permissions","immutable versioning"]},"review":{"status":"draft","reviewer":null,"reviewed_at":null},"tags":["agents","marketplace","sandbox","security","versioning","high"]}
