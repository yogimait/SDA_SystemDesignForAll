{
  "name": "system-design-all-in-one",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "frontend_client",
    "backend-server",
    "packages/contracts"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend_client",
    "dev:backend": "npm run start:dev --workspace backend-server",
    "build:frontend": "npm run build --workspace frontend_client",
    "eval:validate": "node eval/validate-cases.mjs",
    "eval:build": "npm run build --workspace backend-server",
    "eval:structural": "node eval/run-structural.mjs",
    "eval:aggregate": "node eval/aggregate-structural.mjs",
    "eval:mutations": "node eval/make-mutations.mjs",
    "eval:mutations:report": "node eval/aggregate-mutations.mjs",
    "postinstall": "npm run build --workspace @sda/contracts"
  }
}
