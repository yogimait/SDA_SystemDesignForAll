# Copy to .env and fill the keys for local development.
# .env is gitignored. The request header x-provider-api-key always wins.
# When NODE_ENV=production, the backend ignores these local key fallbacks.
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=.data/pglite
MOCK_PROVIDER=0
DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=z-ai/glm-5.3-flash
OPENROUTER_MODELS=z-ai/glm-5.3-flash,anthropic/claude-sonnet-4.5,openai/gpt-5,google/gemini-2.5-pro,deepseek/deepseek-chat
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile,llama-3.1-8b-instant
OPENROUTER_REASONING_EFFORT=low
GROQ_REASONING_EFFORT=low
OPENROUTER_API_KEY=
GROQ_API_KEY=
THROTTLE_LIMIT=1000
THROTTLE_TTL_MS=3600000

# Auth. Durations accept s/m/h/d suffixes. Access tokens are Bearer only;
# the refresh token lives in an httpOnly cookie.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Gate project creation and generation on a verified email (default off in dev).
REQUIRE_EMAIL_VERIFICATION=0
APP_BASE_URL=http://localhost:3000
# Optional: signs the double-submit CSRF cookie. Set in production.
CSRF_SECRET=
AUTH_THROTTLE_LIMIT=5
AUTH_THROTTLE_TTL_MS=60000

# Billing. Leave the Stripe values empty to use the local development stub;
# setting STRIPE_SECRET_KEY switches to Stripe and requires the price id.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
